# /root/leakscan/.env on the VPS (one level above deploy/). Read by compose twice:
#   --env-file .env  -> ${VAR} interpolation in deploy/docker-compose.yml (hosts, port)
#   env_file ../.env -> container environment (the app)
# Names below match public_app.py & co; values are examples, secrets left empty.

# --- compose / routing ---------------------------------------------------------------
LEAKSCAN_PORT=8081                     # host port; 8080 is taken on the VPS -> push.sh forces 8081
LEAKSCAN_HOST=scan.srv1395798.hstgr.cloud   # API host (Traefik router "leakscan"), unchanged
SITE_HOST=abolita.srv1395798.hstgr.cloud    # landing site host; abolita.com after DNS cut-over
SITE_HOST_WWW=www.abolita.srv1395798.hstgr.cloud  # 301 -> SITE_HOST; www.abolita.com after cut-over

# --- upstream APIs (secrets) ------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- CTA contacts shown in the legacy UI --------------------------------------------------
DM_TELEGRAM=
DM_INSTAGRAM=
DM_WHATSAPP=

# --- origins ---------------------------------------------------------------------------
# Browser origins allowed to call /api/* cross-origin (comma list). Same-origin pages need none.
CORS_ORIGINS=https://blackphoenixslo.github.io
# Prefix for /api/media/<slug>/<n>.jpg image src. Empty (default) = relative = same origin.
# Keep https://scan.srv1395798.hstgr.cloud while the GitHub Pages copy (cross-origin) is in use.
PUBLIC_ORIGIN=https://scan.srv1395798.hstgr.cloud

# --- runtime (set by the image/compose; override only if needed) ---------------------------
# PUBLIC_DB=/data/public.db            # sqlite in the leakscan-data volume
# DATA_DIR=                            # default: dir of PUBLIC_DB (avatars/, media/)
# SITE_DIR=/site                       # landing site root; missing dir = site off, legacy UI at /
# TRUST_XFF=1                          # trust X-Forwarded-For (behind Traefik)
# PUBLIC_HOST=0.0.0.0  PUBLIC_PORT=8080
# BIG_SCAN_CSE_IMAGES_ONLY=0  INCOGNITON_DISABLE=1  BIO_VERIFY_ENABLED=0

# --- quick-scan profile (profile_extract.py) ------------------------------------------------
# PROFILE_ENABLED=1  PROFILE_CSE_EXTRA=0  PROFILE_LLM_TIMEOUT=15  PROFILE_BUDGET=20

# --- quick-scan reuse (README "Scan reuse"); seconds, 0 = off --------------------------------
# SCAN_REUSE_TTL=21600
# Scan retention, days by row age (README "Scan retention"); a row is never deleted
# RETAIN_BIG_DAYS=3
# RETAIN_SMALL_DAYS=30

# --- quick-scan SFW media (media_gather.py; Browserbase remote browser) ----------------------
MEDIA_ENABLED=1
MEDIA_BROWSERBASE=1
MEDIA_BUDGET=90                        # seconds per gather
MEDIA_MAX=12                           # photos per scan (capped at 12)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_PROXIES=0

# --- rate limits / caps (defaults shown) ----------------------------------------------------
# RATE_PER_MIN=5 RATE_BURST=5 MAX_CONCURRENT=2 MAX_GLOBAL_SCANS=4 SCAN_TIMEOUT=900
# CHAT_RATE_PER_MIN=20 CHAT_BURST=10 CHAT_MAX_CONCURRENT=3 CHAT_MAX_TOKENS=700
# VERIFY_RATE_PER_MIN=10 VERIFY_BURST=6 VERIFY_MAX_CONCURRENT=2 VERIFY_TIMEOUT=120 BIO_VERIFY_HTTP_ONLY=
# CSE_QUICK_CALLS=8 CSE_DEEP_CALLS=15 CSE_IMAGES=18 CSE_PREFIXES=leaks,porn USE_TOTAL_RESULTS_QUERY=0
# PIPE_DISCOVERY_TIMEOUT=900 PIPE_SHOTS_TIMEOUT=300 THUMB_MAX_BYTES=3000000
# DISPLAY_PER_DOMAIN_MULT=6 DISPLAY_TOTAL_MULT=6 STATS_TOP_DOMAINS=8 TOP_LEAK_URL_MAX_LEN=80
# ESTIMATE_SITES_MULT=30.0 ESTIMATE_URL_MULT=10.0 MIN_SITES_FOR_FALLBACK=7 FALLBACK_EXTRA_PAGES=1
# GALLERY_CAP=24 SHOTS_CAP=10 SHOTS_TOTAL_MAX=6000000 SHOT_MAX_BYTES=1500000 LINKS_CAP=0 PER_DOMAIN_LINKS=0
# GOOGLE_INDEX_MAX=0 CANDIDATES_CAP=40000 AUDIT_DL_CAP=1000000 VAR_MAX=6 VAR_MAX_PLUS=20
